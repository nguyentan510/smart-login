<?xml version="1.0"?>
<ruleset name="Smart Login">
	<description>
		Coding standard for Smart Login.

		Status: NOT clean as of Phase 0. The codebase carries phpcs:ignore
		annotations that were never verified because no ruleset existed. Bringing
		this to zero errors is a Phase 7 deliverable, not a Phase 0 one — do not
		wire it into the required CI gate until then.
	</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<!-- Generated by bin/build-address-data.php; not hand-maintained source. -->
	<exclude-pattern>/data/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.0-"/>
	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="smart-login"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="smart_login"/>
				<element value="smartlogin"/>
				<element value="SMART_LOGIN"/>
				<element value="SmartLogin"/>
			</property>
		</properties>
	</rule>
</ruleset>
