<?xml version="1.0"?>
<ruleset name="Smart Login">
	<description>
		Coding standard for Smart Login.

		Status: NOT clean as of Phase 0. The codebase carries phpcs:ignore
		annotations that were never verified because no ruleset existed. Bringing
		this to zero errors is a Phase 7 deliverable, not a Phase 0 one — do not
		wire it into the required CI gate until then.
	</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<!-- Generated by bin/build-address-data.php; not hand-maintained source. -->
	<exclude-pattern>/data/*</exclude-pattern>
	<!--
		Scope is the code that actually ships. tests/ and scripts/ are excluded
		from the plugin archive by .distignore, and holding a test harness to the
		same escaping and Yoda-condition rules as distributed code buys nothing.
		They are still covered by tests/run-lint.php, which is what matters there.
	-->
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/scripts/*</exclude-pattern>
	<!--
		Build output, and copies rather than source: dist/ holds a staged copy of
		every shipped file while a release archive is being built. Scanning it
		reports each violation twice and doubles the documented baseline, so a
		release in progress looks like a regression. Same reason tests/harness.php
		and tests/run-lint.php skip these two names.
	-->
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.0-"/>
	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress">
		<!--
			WPCS expects class-otpservice.php, because its file-name rule assumes
			WordPress-style Snake_Case class names (My_Class -> class-my-class.php)
			and simply lowercases anything else. This codebase uses namespaced
			CamelCase with a kebab-case autoloader, so complying would rename 57
			files to unreadable forms AND require changing the autoloader regex.
			The sniff encodes an assumption the project deliberately does not share.
		-->
		<exclude name="WordPress.Files.FileName"/>

		<!--
			Template variables are function-scoped locals inside an included file,
			not globals, so a per-file prefix buys nothing. Template variables that
			ARE at risk of collision already carry the sl_ prefix by convention.
		-->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound"/>

		<!--
			Short ternary (?:) is used deliberately for "value or fallback" and is
			clearer than repeating the expression.
		-->
		<exclude name="Universal.Operators.DisallowShortTernary"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!--
		DOCUMENTATION SNIFFS: currently excluded, and this is the one place in the
		configuration that is a deferral rather than a decision.

		Bringing them to zero means writing docblocks for roughly 820 findings
		across 95 files. That is worth doing, but it is mechanical work of a
		different kind from the identity refactor, and mixing the two would bury
		every substantive change in a diff of comment additions.

		What is NOT deferred: every security, correctness, database and
		compatibility sniff is enforced at zero by the gate in tests/run-all.php.
		Each remaining suppression in the source is a one-line phpcs:ignore with a
		written reason next to it.

		As of P7.4 that gate is genuinely at zero — 38 violations were cleared in
		three commits, and tests/run-phpcs.php now fails on the first one added
		back. `ParamNameNoMatch` and `WrongStyle` are NOT in the list below and
		never were: they were simply failing. A docblock that names a parameter
		the function does not have is wrong rather than absent, and absent is the
		only thing this block defers.

		Remove these excludes one at a time, not all at once.
	-->
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
	</rule>
	<rule ref="Squiz.Commenting.VariableComment">
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Squiz.Commenting.VariableComment.MissingVar"/>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment">
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<exclude name="Generic.Commenting.DocComment.ShortNotCapital"/>
		<exclude name="Generic.Commenting.DocComment.LongNotCapital"/>
	</rule>

	<!--
		bin/ holds CLI build tooling that runs under `php bin/…`, not in a request.
		Writing to stdout and to the filesystem is its entire job, and esc_html()
		on terminal output would be wrong rather than safer.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="smart-login"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="smart_login"/>
				<element value="smartlogin"/>
				<element value="SMART_LOGIN"/>
				<element value="SmartLogin"/>
			</property>
		</properties>
		<!--
			bin/ is a standalone CLI script run as `php bin/…`. It never loads inside
			WordPress, so the collision this rule prevents cannot occur there.
		-->
		<exclude-pattern>/bin/*</exclude-pattern>
		<!--
			Firing somebody else's hook is the point: do_action( 'wp_login' ) exists
			so other plugins see a login that did not go through wp-login.php, and
			the WooCommerce template overrides must fire woocommerce_* hooks or the
			templates they replace stop working. A prefix here would break both.
		-->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound"/>
	</rule>

	<rule ref="Squiz.PHP.CommentedOutCode">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>

	<!--
		base64 is not obfuscation here. It decodes JWT segments from a Google ID
		token (base64url is the wire format defined by RFC 7515) and encodes the
		ciphertext of stored provider secrets. Both are documented at the call site.
	-->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode"/>
		<exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode"/>
	</rule>
</ruleset>
